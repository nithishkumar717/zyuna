# ── Bot API Direct Connection (VPS without tunnel) ───────────────────────────
# Set to your VPS public IP and bot API port. Next.js automatically proxies browser
# requests through /api/v1 to avoid browser HTTPS/HTTP Mixed Content blocking!
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8000/api/v1
BOT_API_URL=http://YOUR_VPS_IP:8000

# API Key for authentication (must match DASHBOARD_API_KEY in bot/.env)
NEXT_PUBLIC_DASHBOARD_API_KEY=ZYUNA_SECURE_API_KEY_12345_CHANGE_THIS_ASAP_BY_NERD_X_LIVE

# NextAuth Configuration
NEXTAUTH_URL=https://zyuna.vercel.app
NEXTAUTH_SECRET=zyuna_nextauth_default_secret_string_2026_change_me_BY_NERD_X_LIVE

# Discord OAuth configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=1048900823314354197

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="Zyuna"
NEXT_PUBLIC_BRAND_NAME_WORD="ZY"
NEXT_PUBLIC_SUPPORT_SERVER_URL="https://discord.gg/YzHCx5yQXv"